# Project 3: at-speed transition-delay ATPG (LOC vs LOS) for the Project 2 scan netlist.
#
# Runs one full-scan test mode per sequence style on the same netlist:
#   TDF_LOC  - -dynseqfilter intra,    -dynfuncrelease yes  (scan enable released before launch)
#   TDF_LOS  - -dynseqfilter losintra, -dynfuncrelease no   (scan enable held through the launch shift)
# Option forms are those accepted by Modus 22.10-p008_1; see README.md before changing them.
#
# Default paths are relative to this repository. Override with:
#   P3_NETLIST, P3_CELL_MODELS, P3_LOC_PINASSIGN, P3_LOS_PINASSIGN, P3_TOP,
#   P3_RUN_DIR, P3_CLOCK_CONSTRAINTS (set the last one to run the timed flow).
#
# Modus needs a tty at startup; see README.md for the launch command.

set script_path [file normalize [info script]]
set repo_root [file dirname [file dirname $script_path]]

proc p3_path {root env_name fallback} {
    if {[info exists ::env($env_name)] && $::env($env_name) ne ""} {
        set path $::env($env_name)
    } else {
        set path $fallback
    }
    if {[file pathtype $path] ne "absolute"} {
        set path [file join $root $path]
    }
    return [file normalize $path]
}

set netlist     [p3_path $repo_root P3_NETLIST     ../dft-scan-atpg/p2_scan/runs/c1/top_scan.v]
set cell_models [p3_path $repo_root P3_CELL_MODELS ../dft-scan-atpg/lib/cells.v]
set loc_assign  [p3_path $repo_root P3_LOC_PINASSIGN inputs/top_loc.pinassign]
set los_assign  [p3_path $repo_root P3_LOS_PINASSIGN inputs/top_los.pinassign]

# The design has no SDC-derived clocking, so the untimed flow is the default.
set clock_constraints ""
if {[info exists ::env(P3_CLOCK_CONSTRAINTS)] && $::env(P3_CLOCK_CONSTRAINTS) ne ""} {
    set clock_constraints [p3_path $repo_root P3_CLOCK_CONSTRAINTS $::env(P3_CLOCK_CONSTRAINTS)]
    if {![file isfile $clock_constraints]} {
        error "Clock-constraints file is missing: $clock_constraints"
    }
}

if {[info exists ::env(P3_TOP)] && $::env(P3_TOP) ne ""} {
    set top $::env(P3_TOP)
} else {
    set top top
}

if {[info exists ::env(P3_RUN_DIR)] && $::env(P3_RUN_DIR) ne ""} {
    set run_dir [p3_path $repo_root P3_RUN_DIR runs/manual-run]
} else {
    set stamp [clock format [clock seconds] -format %Y%m%d-%H%M%S]
    set run_dir [file join $repo_root runs modus-$stamp]
}

foreach input [list $netlist $cell_models $loc_assign $los_assign] {
    if {![file isfile $input]} {
        error "Required input is missing: $input. See inputs/README.md and README.md."
    }
}

set workdir $run_dir
set vector_dir [file join $run_dir vectors]
set log_dir [file join $run_dir logs]
file mkdir $workdir
file mkdir $vector_dir
file mkdir $log_dir

puts "Project 3 run directory: $run_dir"
puts "Design top: $top"
puts "Netlist: $netlist"
puts "Cell models: $cell_models"
puts "Dynamic clocking: [expr {$clock_constraints eq "" ? "dynseqfilter only (untimed flow)" : "clockconstraints $clock_constraints"}]"

# -designtop is the module name; -techlib takes the Verilog cell models.
build_model \
    -designsource $netlist \
    -designtop $top \
    -techlib $cell_models \
    -allowmissingmodules yes \
    -workdir $workdir

# One full-scan mode per sequence style. Both pin assigns describe the same single chain;
# LOC and LOS differ only in the dynamic-test options below.
build_testmode \
    -testmode TDF_LOC \
    -assignfile $loc_assign \
    -modedef FULLSCAN \
    -workdir $workdir

build_testmode \
    -testmode TDF_LOS \
    -assignfile $los_assign \
    -modedef FULLSCAN \
    -workdir $workdir

verify_test_structures -testmode TDF_LOC -workdir $workdir
verify_test_structures -testmode TDF_LOS -workdir $workdir

# Dynamic faults only. -fullfault is an alias for -cellinternal on this release, not "all faults".
build_faultmodel \
    -includedynamic yes \
    -workdir $workdir

set summary [file join $log_dir kpi.txt]
set fh [open $summary w]
puts $fh "# Project 3 transition ATPG -- generated by scripts/run_modus.tcl"
puts $fh "# Modus 22.10-p008_1; design top $top; run $run_dir"
close $fh

proc p3_kpi {file key value} {
    if {![string length $value]} { set value NA }
    set fh [open $file a]
    puts $fh "$key $value"
    close $fh
}

# Reads tbdata/modus_metrics into a dict of fully qualified key -> value.
proc p3_metrics {path} {
    set d [dict create]
    if {![file isfile $path]} { return $d }
    set fh [open $path r]
    set txt [read $fh]
    close $fh
    foreach line [split $txt \n] {
        if {[regexp {^\s*([A-Za-z0-9_.:\-]+)\s+(\S+)\s*$} $line -> key value]} {
            dict set d $key $value
        }
    }
    return $d
}

array set p3_runtime {}
array set p3_sequence {}
array set p3_release {}
array set p3_experiment {}

foreach {mode experiment sequence release tag} {
    TDF_LOC loc_exp intra   yes loc
    TDF_LOS los_exp losintra no los
} {
    puts "Starting $mode transition ATPG: dynseqfilter=$sequence dynfuncrelease=$release"
    set p3_sequence($mode) $sequence
    set p3_release($mode) $release
    set p3_experiment($mode) $experiment
    set started_ms [clock milliseconds]

    set dyn_opts [list \
        -testmode $mode \
        -experiment $experiment \
        -dynseqfilter $sequence \
        -dynfuncrelease $release \
        -workdir $workdir]
    if {$clock_constraints ne ""} {
        lappend dyn_opts -clockconstraints $clock_constraints
    }
    create_logic_delay_tests {*}$dyn_opts

    set elapsed_seconds [expr {([clock milliseconds] - $started_ms) / 1000.0}]
    set p3_runtime($mode) $elapsed_seconds
    puts "P3_ATPG_RUNTIME_SECONDS $mode $elapsed_seconds"

    commit_tests \
        -testmode $mode \
        -inexperiment $experiment \
        -workdir $workdir

    # -outputfilename is a bare name; the directory comes from -exportdir.
    write_vectors \
        -testmode $mode \
        -language verilog \
        -scanformat parallel \
        -outputfilename ${tag}_transition \
        -exportdir $vector_dir \
        -workdir $workdir
}

# Modus flushes tbdata/modus_metrics late, so read it only after both modes have been generated.
set metrics [file join $workdir tbdata modus_metrics]
if {[file isfile $metrics]} {
    file copy -force $metrics [file join $run_dir modus_metrics.txt]
} else {
    puts "WARNING: $metrics not found -- fault KPIs will be NA"
}
set met [p3_metrics $metrics]

foreach {mode tag} {TDF_LOC loc TDF_LOS los} {
    set kpi [file join $log_dir kpi_${tag}.txt]
    set fh [open $kpi w]
    puts $fh "# $mode, dynseqfilter=$p3_sequence($mode) dynfuncrelease=$p3_release($mode)"
    close $fh

    # Keys must be built here: a ${mode} reference inside a braced foreach
    # list is not substituted, which silently turned every lookup into NA.
    set dyn    "atpg.testmode:$mode.stats:dynamic"
    set expdyn "atpg.testmode:$mode.experiment:$p3_experiment($mode).stats:dynamic"
    set counts "atpg.testmode:$mode"

    # TCov (as opposed to ATCov) is only reported per experiment on this release.
    foreach {label suffix} {
        testmode_tcov tcov
        global_tcov    global_tcov
    } {
        set v ""
        set key "$expdyn.$suffix"
        if {[dict exists $met $key]} { set v [dict get $met $key] }
        p3_kpi $kpi $label [regsub {%$} $v ""]
        p3_kpi $summary $mode.$label [regsub {%$} $v ""]
    }

    foreach {label suffix} {
        testmode_total_faults      total_faults
        testmode_tested_faults     tested_faults
        testmode_untested_faults   untested_faults
        testmode_possible_faults   possible_faults
        testmode_redundant_faults  redundant_faults
        testmode_atcov             atcov
        global_total_faults        global_total_faults
        global_tested_faults       global_tested_faults
        global_untested_faults     global_untested_faults
        global_atcov               global_atcov
    } {
        set v ""
        set key "$dyn.$suffix"
        if {[dict exists $met $key]} { set v [dict get $met $key] }
        p3_kpi $kpi $label [regsub {%$} $v ""]
        p3_kpi $summary $mode.$label [regsub {%$} $v ""]
    }

    foreach {label suffix} {
        num_tests       num_tests
        num_logic_tests num_logic_delay_tests
        num_scan_tests  num_scan_tests
    } {
        set v ""
        set key "$counts.$suffix"
        if {[dict exists $met $key]} { set v [dict get $met $key] }
        p3_kpi $kpi $label $v
        p3_kpi $summary $mode.$label $v
    }

    p3_kpi $kpi atpg_runtime_seconds $p3_runtime($mode)
    p3_kpi $summary $mode.atpg_runtime_seconds $p3_runtime($mode)
}

puts "Finished LOC and LOS transition ATPG. Vectors and Modus database are in: $run_dir"
exit
