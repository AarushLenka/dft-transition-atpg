@file(scripts/run_modus.tcl) 53: set clock_constraints ""
@file(scripts/run_modus.tcl) 54: if {[info exists ::env(P3_CLOCK_CONSTRAINTS)] && $::env(P3_CLOCK_CONSTRAINTS) ne ""} {
    set clock_constraints [p3_path $repo_root P3_CLOCK_CONSTRAINTS $::env(P3_CLOCK_CONSTRAINTS)]
    if {![file isfile $clock_constraints]} {
        error "Clock-constraints file is missing: $clock_constraints"
    }
}
@file(scripts/run_modus.tcl) 61: if {[info exists ::env(P3_TOP)] && $::env(P3_TOP) ne ""} {
