@file(scripts/run_modus.tcl) 201: set metrics [file join $workdir tbdata modus_metrics]
@file(scripts/run_modus.tcl) 202: if {[file isfile $metrics]} {
    file copy -force $metrics [file join $run_dir modus_metrics.txt]
} else {
    puts "WARNING: $metrics not found -- fault KPIs will be NA"
}
@file(scripts/run_modus.tcl) 207: set met [p3_metrics $metrics]
@file(scripts/run_modus.tcl) 209: foreach {mode tag} {TDF_LOC loc TDF_LOS los} {
    set kpi [file join $log_dir kpi_${tag}.txt]
    set fh [open $kpi w]
    puts $fh "# $mode, dynseqfilter=$p3_sequence($mode) dynfuncrelease=$p3_release($mode)"
    close $fh
    # Keys must be built here: a ${mode} reference inside a braced foreach
    # list is not substituted, which silently turned every lookup into NA.
    set dyn    "atpg.testmode:$mode.stats:dynamic"
    set expdyn "atpg.testmode:$mode.experiment:$p3_experiment($mode).stats:dynamic"
    set counts "atpg.testmode:$mode"
    # TCov (as opposed to ATCov) is only reported per experiment on this release.
    foreach {label suffix} {
        testmode_tcov tcov
        global_tcov    global_tcov
    } {
        set v ""
        set key "$expdyn.$suffix"
        if {[dict exists $met $key]} { set v [dict get $met $key] }
        p3_kpi $kpi $label [regsub {%$} $v ""]
        p3_kpi $summary $mode.$label [regsub {%$} $v ""]
    }
    foreach {label suffix} {
        testmode_total_faults      total_faults
        testmode_tested_faults     tested_faults
        testmode_untested_faults   untested_faults
        testmode_possible_faults   possible_faults
        testmode_redundant_faults  redundant_faults
        testmode_atcov             atcov
        global_total_faults        global_total_faults
        global_tested_faults       global_tested_faults
        global_untested_faults     global_untested_faults
        global_atcov               global_atcov
    } {
        set v ""
        set key "$dyn.$suffix"
        if {[dict exists $met $key]} { set v [dict get $met $key] }
        p3_kpi $kpi $label [regsub {%$} $v ""]
        p3_kpi $summary $mode.$label [regsub {%$} $v ""]
    }
    foreach {label suffix} {
        num_tests       num_tests
        num_logic_tests num_logic_delay_tests
        num_scan_tests  num_scan_tests
    } {
        set v ""
        set key "$counts.$suffix"
        if {[dict exists $met $key]} { set v [dict get $met $key] }
        p3_kpi $kpi $label $v
        p3_kpi $summary $mode.$label $v
    }
    p3_kpi $kpi atpg_runtime_seconds $p3_runtime($mode)
    p3_kpi $summary $mode.atpg_runtime_seconds $p3_runtime($mode)
}
