#@ Begin verbose source scripts/run_modus.tcl
@file(scripts/run_modus.tcl) 32: set script_path [file normalize [info script]]
@file(scripts/run_modus.tcl) 33: set repo_root [file dirname [file dirname $script_path]]
@file(scripts/run_modus.tcl) 35: proc p3_path {root env_name fallback} {
    if {[info exists ::env($env_name)] && $::env($env_name) ne ""} {
        set path $::env($env_name)
    } else {
        set path $fallback
    }
    if {[file pathtype $path] ne "absolute"} {
        set path [file join $root $path]
    }
    return [file normalize $path]
}
@file(scripts/run_modus.tcl) 48: set netlist     [p3_path $repo_root P3_NETLIST     ../dft-scan-atpg/p2_scan/runs/c1/top_scan.v]
