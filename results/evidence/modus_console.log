} else {
    set top top
}
@file(scripts/run_modus.tcl) 67: if {[info exists ::env(P3_RUN_DIR)] && $::env(P3_RUN_DIR) ne ""} {
    set run_dir [p3_path $repo_root P3_RUN_DIR runs/manual-run]
} else {
    set stamp [clock format [clock seconds] -format %Y%m%d-%H%M%S]
    set run_dir [file join $repo_root runs modus-$stamp]
}
@file(scripts/run_modus.tcl) 74: foreach input [list $netlist $cell_models $loc_assign $los_assign] {
