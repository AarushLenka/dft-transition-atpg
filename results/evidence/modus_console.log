@file(scripts/run_modus.tcl) 124: set summary [file join $log_dir kpi.txt]
@file(scripts/run_modus.tcl) 125: set fh [open $summary w]
@file(scripts/run_modus.tcl) 126: puts $fh "# Project 3 transition ATPG -- generated by scripts/run_modus.tcl"
@file(scripts/run_modus.tcl) 127: puts $fh "# Modus 22.10-p008_1; design top $top; run $run_dir"
@file(scripts/run_modus.tcl) 128: close $fh
@file(scripts/run_modus.tcl) 130: proc p3_kpi {file key value} {
    if {![string length $value]} { set value NA }
    set fh [open $file a]
    puts $fh "$key $value"
    close $fh
}
@file(scripts/run_modus.tcl) 140: proc p3_metrics {path} {
    set d [dict create]
    if {![file isfile $path]} { return $d }
    set fh [open $path r]
    set txt [read $fh]
    close $fh
    foreach line [split $txt \n] {
        if {[regexp {^\s*([A-Za-z0-9_.:\-]+)\s+(\S+)\s*$} $line -> key value]} {
            dict set d $key $value
        }
    }
    return $d
}
@file(scripts/run_modus.tcl) 154: array set p3_runtime {}
@file(scripts/run_modus.tcl) 155: array set p3_sequence {}
@file(scripts/run_modus.tcl) 156: array set p3_release {}
@file(scripts/run_modus.tcl) 157: array set p3_experiment {}
@file(scripts/run_modus.tcl) 159: foreach {mode experiment sequence release tag} {
    TDF_LOC loc_exp intra   yes loc
    TDF_LOS los_exp losintra no los
} {
    puts "Starting $mode transition ATPG: dynseqfilter=$sequence dynfuncrelease=$release"
    set p3_sequence($mode) $sequence
    set p3_release($mode) $release
    set p3_experiment($mode) $experiment
    set started_ms [clock milliseconds]

    set dyn_opts [list \
        -testmode $mode \
        -experiment $experiment \
        -dynseqfilter $sequence \
        -dynfuncrelease $release \
        -workdir $workdir]
    if {$clock_constraints ne ""} {
        lappend dyn_opts -clockconstraints $clock_constraints
    }
    create_logic_delay_tests {*}$dyn_opts

    set elapsed_seconds [expr {([clock milliseconds] - $started_ms) / 1000.0}]
    set p3_runtime($mode) $elapsed_seconds
    puts "P3_ATPG_RUNTIME_SECONDS $mode $elapsed_seconds"

    commit_tests \
        -testmode $mode \
        -inexperiment $experiment \
        -workdir $workdir

    write_vectors \
        -testmode $mode \
        -language verilog \
        -scanformat parallel \
        -outputfilename ${tag}_transition \
        -exportdir $vector_dir \
        -workdir $workdir
}
